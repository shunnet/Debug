<UserControl
    x:Class="Snet.Iot.Debug.view.CommunicationService"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:h="clr-namespace:Snet.Windows.Controls.handler;assembly=Snet.Windows.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Snet.Iot.Debug.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Snet.Iot.Debug.viewModel"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:uis="http://schemas.lepo.co/wpfui/2022/xaml"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <model:CommunicationServiceModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <snet:RadioButtonConverter x:Key="RadioButtonConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox
        Grid.Row="0"
        Padding="0"
        ui:ElevationAssist.Elevation="Dp5"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding ToolTitle}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--  右侧打开关闭  -->
            <StackPanel
                Margin="0,-31,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,0,0,0"
                    Command="{Binding On}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource ConnectBase}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 打开}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                    Command="{Binding Off}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource OffConnect}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 关闭}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
            </StackPanel>



            <!--  功能  -->
            <GroupBox
                Grid.Row="0"
                Margin="10,10,10,10"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="Function" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 功能}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <!--  内部功能按钮  -->
                <Grid>
                    <!--  操作  -->
                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <!--  内容  -->
                        <snet:TextBoxControl
                            Margin="5,5,10,5"
                            Hint="{snet:Loc 数据}"
                            Icon="{DynamicResource Data}"
                            Text="{Binding Data}" />
                        <!--  数据格式  -->
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Margin="0,0,15,0"
                                Content="{snet:Loc 群发}"
                                IsChecked="{Binding MassSend, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignSecondaryCheckBox}" />
                            <RadioButton
                                Margin="0,0,15,0"
                                Content="ASCII"
                                IsChecked="{Binding DataFormat, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=0}"
                                Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                            <RadioButton
                                Margin="0,0,15,0"
                                Content="Hex"
                                IsChecked="{Binding DataFormat, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=1}"
                                Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        </StackPanel>
                        <!--  发送  -->
                        <snet:ButtonControl
                            Grid.Column="2"
                            Width="110"
                            Margin="0,5,5,5"
                            Command="{Binding Send}"
                            Content="{snet:Loc 发送}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Send}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <!--  查阅  -->
            <ui:Card Grid.Row="1" Margin="10,0,10,10">
                <TabControl
                    ui:NavigationRailAssist.ShowSelectionBackground="True"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding TabSelectedIndex}"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Left">

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="Tune" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 参数}" />
                            </StackPanel>
                        </TabItem.Header>
                        <snet:PropertyControl
                            Margin="10,0,0,0"
                            BasicsData="{Binding BasicsData}"
                            ExpCommand="{x:Null}"
                            IncCommand="{x:Null}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="MessageAlertOutline" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 信息}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="MessageAlertOutline" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 信息}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <Grid>
                                <!--  清空按钮  -->
                                <Button
                                    Width="80"
                                    Margin="0,-32,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                                    Command="{Binding InfoClear}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource Clear}"
                                                Stretch="Fill" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 清空}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!--  数据框  -->
                                <edit:TextEditor
                                    x:Name="edit1"
                                    h:EditBindingHandler.EditText="{Binding InfoEvent}"
                                    IsReadOnly="True"
                                    PreviewKeyDown="TextEditor_PreviewKeyDown"
                                    PreviewTextInput="TextEditor_PreviewTextInput"
                                    TextChanged="TextEditor_TextChanged">
                                    <edit:TextEditor.Resources>
                                        <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                        <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                    </edit:TextEditor.Resources>
                                </edit:TextEditor>

                            </Grid>
                        </GroupBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="Database" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 数据}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="Database" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 数据}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <Grid>
                                <!--  清空按钮  -->
                                <Button
                                    Width="80"
                                    Margin="0,-32,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                                    Command="{Binding DataClear}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource Clear}"
                                                Stretch="Fill" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 清空}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!--  数据框  -->
                                <edit:TextEditor
                                    x:Name="edit2"
                                    h:EditBindingHandler.EditText="{Binding DataEvent}"
                                    IsReadOnly="True"
                                    PreviewKeyDown="TextEditor_PreviewKeyDown"
                                    PreviewTextInput="TextEditor_PreviewTextInput"
                                    TextChanged="TextEditor_TextChanged">
                                    <edit:TextEditor.Resources>
                                        <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                        <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                    </edit:TextEditor.Resources>
                                </edit:TextEditor>

                            </Grid>
                        </GroupBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="User" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 客户端}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="User" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 客户端}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>

                            <DataGrid
                                ui:DataGridAssist.CornerRadius="0"
                                ui:DataGridAssist.SelectedCellBorderBrush="Transparent"
                                ui:TextFieldAssist.DecorationVisibility="Collapsed"
                                ui:TextFieldAssist.UnderlineBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                AutoGenerateColumns="False"
                                Background="Transparent"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False"
                                CanUserResizeRows="False"
                                CanUserSortColumns="False"
                                ColumnHeaderHeight="40"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding DataGridItemsSource}"
                                SelectionMode="Single"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <snet:EventCommand Command="{Binding GridDataSelectionChanged}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                        snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                        Binding="{Binding IpAddress}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Image
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Address}"
                                                    Stretch="Fill" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 地址}"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <!--  单元格内容居中  -->
                                        <DataGridTextColumn.CellStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="{x:Type DataGridCell}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                        snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                        Binding="{Binding Port}">
                                        <DataGridTextColumn.Header>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Image
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Port}"
                                                    Stretch="Fill" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 端口}"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <!--  单元格内容居中  -->
                                        <DataGridTextColumn.CellStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="{x:Type DataGridCell}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </GroupBox>
                    </TabItem>
                </TabControl>
            </ui:Card>

            <!--  状态  -->
            <Border
                Grid.Row="2"
                Padding="5"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="0,1,0,0">
                <Grid VerticalAlignment="Bottom">
                    <snet:LedGaugeControl
                        Width="25"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        IsFlashing="{Binding DeviceStatusFlashing}"
                        IsOn="{Binding DeviceStatusChangLiang}"
                        OffLightness="0.1"
                        Color="{Binding LedColor}" />

                </Grid>
            </Border>

        </Grid>
    </GroupBox>
</UserControl>
