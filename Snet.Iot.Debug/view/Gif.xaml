<UserControl
    x:Class="Snet.Iot.Debug.view.Gif"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Snet.Iot.Debug.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:viewModel="clr-namespace:Snet.Iot.Debug.viewModel"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <viewModel:GifModel />
    </UserControl.DataContext>
    <GroupBox
        Padding="5"
        ui:ElevationAssist.Elevation="Dp2"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{snet:Loc 视频转Gif}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox
                Grid.Row="0"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="AllergyOutline" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 参数}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Width="105"
                        Height="30"
                        Margin="0,-31,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ui:ButtonAssist.CornerRadius="0,0,0,0"
                        Command="{Binding StartConvert}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource Transition}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 转换}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>


                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="10,10,10,0"
                        Hint="{snet:Loc FFmpeg 工具路径}"
                        Icon="{DynamicResource Path}"
                        Text="{Binding FFmpegTool}" />
                    <snet:TextBoxControl
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Hint="{snet:Loc 文件路径}"
                        Icon="{DynamicResource Path}"
                        Text="{Binding FliePath}" />


                    <snet:TextBoxControl
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="10,0,10,10"
                        Hint="{snet:Loc 存储路径}"
                        Icon="{DynamicResource Path}"
                        Text="{Binding FlieStoragePath}" />
                    <snet:ButtonControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="150"
                        Margin="0,10,10,10"
                        Command="{Binding SelectFliePath}"
                        Content="{snet:Loc 选择文件路径}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Select}" />
                    <snet:ButtonControl
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="150"
                        Margin="0,0,10,10"
                        Command="{Binding SelectFlieStoragePath}"
                        Content="{snet:Loc 选择存储路径}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Select}" />
                </Grid>
            </GroupBox>
            <GroupBox
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="CalendarExport" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 转换结果}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <!--  清空按钮  -->
                    <Button
                        Width="80"
                        Height="30"
                        Margin="0,-31,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ui:ButtonAssist.CornerRadius="0,0,0,0"
                        Command="{Binding ResultClear}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource Clear}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 清空}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                    <TextBox
                        Margin="5"
                        AcceptsReturn="True"
                        BorderThickness="0,0,0,0"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                        Text="{Binding OutData}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Hidden">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="TextChanged">
                                <snet:EventCommand Command="{Binding OutDataTextChanged}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </Grid>

            </GroupBox>
        </Grid>

    </GroupBox>
</UserControl>
