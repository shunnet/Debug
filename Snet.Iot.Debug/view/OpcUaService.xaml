<UserControl
    x:Class="Snet.Iot.Debug.view.OpcUaService"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Snet.Windows.Controls.handler;assembly=Snet.Windows.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Snet.Iot.Debug.viewModel"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <model:OpcUaServiceModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <snet:RadioButtonConverter x:Key="RadioButtonConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox
        Grid.Row="0"
        Padding="0"
        ui:ElevationAssist.Elevation="Dp5"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{snet:Loc OpcUaService}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--  右侧打开关闭  -->
            <StackPanel
                Margin="0,-31,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,0,0,0"
                    Command="{Binding On}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource ConnectBase}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 打开}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                    Command="{Binding Off}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource OffConnect}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 关闭}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
            </StackPanel>

            <!--  内部功能按钮  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  数据类型  -->
                <GroupBox
                    Grid.Row="0"
                    Margin="10"
                    Padding="0"
                    ui:ElevationAssist.Elevation="Dp2"
                    ui:GroupBoxAssist.HeaderPadding="7"
                    Header="{Binding}"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ui:PackIcon Grid.Column="0" Kind="CallMerge" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 数据类型}"
                                    TextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid Margin="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="String"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=21}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Double"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=3}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Float"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=4}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Bool"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=2}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Int"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=10}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="UInt"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=12}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Long"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=14}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="ULong"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=16}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Short"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=6}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="UShort"
                            IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=8}"
                            Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    </Grid>
                </GroupBox>
                <!--  操作  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="10,0,10,10"
                    Padding="5"
                    ui:ElevationAssist.Elevation="Dp2"
                    ui:GroupBoxAssist.HeaderPadding="7"
                    Header="{Binding}"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ui:PackIcon Grid.Column="0" Kind="AddressMarkerOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 地址操作}"
                                    TextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <!--  右侧导入节点获取集合  -->
                        <StackPanel
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Margin="0,-36,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="2"
                            Orientation="Horizontal">
                            <Button
                                Width="130"
                                Height="30"
                                Padding="0"
                                ui:ButtonAssist.CornerRadius="0,0,0,0"
                                Command="{Binding IncDot}"
                                Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Inc}"
                                            Stretch="Fill" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 导入节点}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button
                                Width="130"
                                Height="30"
                                Padding="0"
                                ui:ButtonAssist.CornerRadius="0,5,0,0"
                                Command="{Binding GetAddressArray}"
                                Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Get}"
                                            Stretch="Fill" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 获取集合}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Height="40" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Height="40" />
                        <Grid
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Height="40" />

                        <!--  父级  -->
                        <snet:ComboBoxControl
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5,0,5,0"
                            DisplayMemberPath="Key"
                            Hint="{snet:Loc 父级}"
                            Icon="{DynamicResource 编码类型}"
                            ItemsSource="{Binding ComboBoxItemsSource}"
                            SelectedItem="{Binding ComboBoxSelectedItem}" />

                        <!--  父级名称  -->
                        <snet:TextBoxControl
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            Hint="{snet:Loc 父级名称}"
                            Icon="{DynamicResource GroupName}"
                            Text="{Binding FolderName}" />

                        <!--  创建父级  -->
                        <snet:ButtonControl
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding CreateFolder}"
                            Content="{snet:Loc 创建父级}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Add}" />
                        <!--  移除父级  -->
                        <snet:ButtonControl
                            Grid.Row="0"
                            Grid.Column="3"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding RemoveFolder}"
                            Content="{snet:Loc 移除父级}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Remove}" />


                        <!--  节点地址  -->
                        <snet:TextBoxControl
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="5,0,5,0"
                            VerticalAlignment="Center"
                            Hint="{snet:Loc 节点地址}"
                            Icon="{DynamicResource Address}"
                            Text="{Binding DotAddress}" />

                        <!--  创建  -->
                        <snet:ButtonControl
                            Grid.Row="1"
                            Grid.Column="2"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding Add}"
                            Content="{snet:Loc 创建}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Add}" />
                        <!--  移除  -->
                        <snet:ButtonControl
                            Grid.Row="1"
                            Grid.Column="3"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding Remove}"
                            Content="{snet:Loc 移除}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Remove}" />


                        <!--  写入的数据  -->
                        <snet:TextBoxControl
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="5,0,5,0"
                            Hint="{snet:Loc 写入数据}"
                            Icon="{DynamicResource Write}"
                            Text="{Binding WriteInData}" />

                        <!--  读取  -->
                        <snet:ButtonControl
                            Grid.Row="2"
                            Grid.Column="2"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding Read}"
                            Content="{snet:Loc 读取}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Read}" />
                        <!--  写入  -->
                        <snet:ButtonControl
                            Grid.Row="2"
                            Grid.Column="3"
                            Width="120"
                            Margin="5,0,5,0"
                            Command="{Binding Write}"
                            Content="{snet:Loc 写入}"
                            CornerRadius="{DynamicResource WindowCornerRadius}"
                            Icon="{DynamicResource Write}" />

                    </Grid>


                </GroupBox>
                <!--  查阅  -->
                <ui:Card Grid.Row="2" Margin="10,5,10,10">
                    <TabControl
                        ui:NavigationRailAssist.ShowSelectionBackground="True"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        SelectedIndex="{Binding TabSelectedIndex}"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        TabStripPlacement="Left">

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="Tune" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 参数}" />
                                </StackPanel>
                            </TabItem.Header>
                            <snet:PropertyControl
                                Margin="10,0,0,0"
                                BasicsData="{Binding BasicsData}"
                                ExpCommand="{x:Null}"
                                IncCommand="{x:Null}" />
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="MessageAlertOutline" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 信息}" />
                                </StackPanel>
                            </TabItem.Header>
                            <GroupBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                ui:ElevationAssist.Elevation="Dp4"
                                ui:GroupBoxAssist.HeaderPadding="7"
                                Header="{Binding}"
                                Style="{StaticResource MaterialDesignCardGroupBox}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:PackIcon
                                                Grid.Column="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="MessageAlertOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 信息}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <Grid>
                                    <!--  清空按钮  -->
                                    <Button
                                        Width="80"
                                        Margin="0,-32,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        ui:ButtonAssist.CornerRadius="0,5,0,0"
                                        Command="{Binding InfoClear}"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Clear}"
                                                    Stretch="Fill" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 清空}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!--  数据框  -->
                                    <snet:TextEditorControl
                                        x:Name="edit1"
                                        h:EditBindingHandler.EditText="{Binding InfoEvent}"
                                        IsReadOnly="True"
                                        PreviewKeyDown="TextEditor_PreviewKeyDown"
                                        PreviewTextInput="TextEditor_PreviewTextInput"
                                        TextChanged="TextEditor_TextChanged">
                                        <snet:TextEditorControl.Resources>
                                            <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                        </snet:TextEditorControl.Resources>
                                    </snet:TextEditorControl>

                                </Grid>
                            </GroupBox>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="Database" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 数据}" />
                                </StackPanel>
                            </TabItem.Header>
                            <GroupBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                ui:ElevationAssist.Elevation="Dp4"
                                ui:GroupBoxAssist.HeaderPadding="7"
                                Header="{Binding}"
                                Style="{StaticResource MaterialDesignCardGroupBox}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:PackIcon
                                                Grid.Column="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="Database" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 数据}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <Grid>
                                    <!--  清空按钮  -->
                                    <Button
                                        Width="80"
                                        Margin="0,-32,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        ui:ButtonAssist.CornerRadius="0,5,0,0"
                                        Command="{Binding DataClear}"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Clear}"
                                                    Stretch="Fill" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 清空}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!--  数据框  -->
                                    <snet:TextEditorControl
                                        x:Name="edit2"
                                        h:EditBindingHandler.EditText="{Binding DataEvent}"
                                        IsReadOnly="True"
                                        PreviewKeyDown="TextEditor_PreviewKeyDown"
                                        PreviewTextInput="TextEditor_PreviewTextInput"
                                        TextChanged="TextEditor_TextChanged">
                                        <snet:TextEditorControl.Resources>
                                            <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                        </snet:TextEditorControl.Resources>
                                    </snet:TextEditorControl>

                                </Grid>
                            </GroupBox>
                        </TabItem>
                    </TabControl>
                </ui:Card>
            </Grid>
            <!--  状态  -->
            <Border
                Grid.Row="1"
                Padding="5"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="0,1,0,0">
                <Grid VerticalAlignment="Bottom">
                    <snet:LedGaugeControl
                        Width="25"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        IsFlashing="{Binding DeviceStatusFlashing}"
                        IsOn="{Binding DeviceStatusChangLiang}"
                        OffLightness="0.1"
                        Color="{Binding LedColor}" />

                </Grid>
            </Border>
        </Grid>
    </GroupBox>
</UserControl>
