<UserControl
    x:Class="Snet.Iot.Debug.view.Svg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Snet.Iot.Debug.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:viewModel="clr-namespace:Snet.Iot.Debug.viewModel"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <viewModel:SvgModel />
    </UserControl.DataContext>
    <GroupBox
        Padding="0"
        ui:ElevationAssist.Elevation="Dp2"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{snet:Loc Svg转换工具}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox
                Grid.Row="0"
                Margin="10,10,10,0"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="AllergyOutline" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 参数}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="10,10,10,10"
                        VerticalAlignment="Center"
                        Hint="{snet:Loc 名称}"
                        Icon="{DynamicResource GroupName}"
                        Text="{Binding Name}" />
                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,10,10,10"
                        VerticalAlignment="Center"
                        Hint="{snet:Loc 注释}"
                        Icon="{DynamicResource Calibration}"
                        Text="{Binding Annotation}" />

                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,10,10,10"
                        VerticalAlignment="Center"
                        Hint="{snet:Loc 颜色}"
                        Icon="{DynamicResource TirePressure}"
                        Text="{Binding Color}" />


                    <snet:ButtonControl
                        Grid.Column="3"
                        Width="100"
                        Margin="0,10,10,10"
                        Command="{Binding Transition}"
                        Content="{snet:Loc 转换}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Transition}" />
                    <snet:ButtonControl
                        Grid.Column="4"
                        Width="100"
                        Margin="0,10,10,10"
                        Command="{Binding Copy}"
                        Content="{snet:Loc 复制}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Copy}" />
                </Grid>
            </GroupBox>

            <GroupBox
                Grid.Row="1"
                Margin="10,10,10,0"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="Svg" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc Svg代码}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <!--  清空按钮  -->
                    <Button
                        Width="80"
                        Height="30"
                        Margin="0,-31,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ui:ButtonAssist.CornerRadius="0,0,0,0"
                        Command="{Binding CodeClear}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource Clear}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 清空}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                    <TextBox
                        Margin="5"
                        AcceptsReturn="True"
                        BorderThickness="0,0,0,0"
                        IsReadOnly="False"
                        Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                        Text="{Binding InputData}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Hidden" />
                </Grid>

            </GroupBox>

            <GroupBox
                Grid.Row="2"
                Margin="10"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="CalendarExport" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 转换结果}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <!--  清空按钮  -->
                    <Button
                        Width="80"
                        Height="30"
                        Margin="0,-31,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ui:ButtonAssist.CornerRadius="0,0,0,0"
                        Command="{Binding ResultClear}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource Clear}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 清空}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                    <TextBox
                        Margin="5"
                        AcceptsReturn="True"
                        BorderThickness="0,0,0,0"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                        Text="{Binding OutData}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Hidden" />
                </Grid>

            </GroupBox>
        </Grid>

    </GroupBox>
</UserControl>
