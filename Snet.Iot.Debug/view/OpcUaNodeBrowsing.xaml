<UserControl
    x:Class="Snet.Iot.Debug.view.OpcUaNodeBrowsing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Snet.Iot.Debug.model"
    xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:h="clr-namespace:Snet.Windows.Controls.handler;assembly=Snet.Windows.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Snet.Iot.Debug.viewModel"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:uis="http://schemas.lepo.co/wpfui/2022/xaml"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <model:OpcUaNodeBrowsingModel />
    </UserControl.DataContext>
    <GroupBox
        Grid.Row="0"
        Padding="0"
        ui:ElevationAssist.Elevation="Dp2"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{snet:Loc 节点信息浏览}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--  右侧打开关闭  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,-31,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,0,0,0"
                    Command="{Binding On}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource ConnectBase}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 打开}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                    Command="{Binding Off}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource OffConnect}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 关闭}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
            </StackPanel>
            <!--  节点  -->
            <Grid Grid.Column="0">
                <GroupBox
                    Grid.Row="0"
                    Margin="10"
                    Padding="0"
                    ui:ElevationAssist.Elevation="Dp2"
                    ui:GroupBoxAssist.HeaderPadding="7"
                    Header="{Binding}"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ui:PackIcon Grid.Column="0" Kind="ResistorNodes" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 节点}"
                                    TextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <TreeView
                        Margin="5,5,0,5"
                        Background="Transparent"
                        ItemsSource="{Binding Node}"
                        ScrollViewer.CanContentScroll="True"
                        Style="{StaticResource DefaultTreeViewStyle}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <!--  右键菜单  -->
                        <TreeView.ContextMenu>
                            <ContextMenu
                                VerticalContentAlignment="Center"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language">
                                <ContextMenu.Style>
                                    <Style BasedOn="{StaticResource UiContextMenu}" TargetType="ContextMenu" />
                                </ContextMenu.Style>
                                <uis:MenuItem
                                    Header="{snet:Loc 导出节点}"
                                    Icon="{uis:SymbolIcon Symbol=ArrowExit20,
                                                          Filled=False}"
                                    Style="{StaticResource UiMenuItem}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <snet:EventCommand Command="{Binding ContextMenu_ExpNode}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </uis:MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <i:Interaction.Triggers>
                            <!--  选中  -->
                            <i:EventTrigger EventName="SelectedItemChanged">
                                <snet:EventCommand Command="{Binding TreeView_SelectedItemChanged}" />
                            </i:EventTrigger>
                            <!--  右键按下  -->
                            <i:EventTrigger EventName="PreviewMouseRightButtonDown">
                                <snet:EventCommand Command="{Binding TreeView_PreviewMouseRightButtonDown}" />
                            </i:EventTrigger>
                            <!--  项被展开  -->
                            <snet:RoutedEventTrigger RoutedEventName="TreeViewItem.Expanded">
                                <snet:EventCommand Command="{Binding TreeViewItem_Expanded}" />
                            </snet:RoutedEventTrigger>
                            <!--  滚动条到底部  -->
                            <snet:RoutedEventTrigger RoutedEventName="ScrollViewer.ScrollChanged">
                                <snet:EventCommand Command="{Binding ScrollViewer_ScrollChanged}" />
                            </snet:RoutedEventTrigger>

                        </i:Interaction.Triggers>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultTreeViewItemStyle}" TargetType="TreeViewItem" />
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type data:OpcUaNodeBrowseStructuralBody}" ItemsSource="{Binding Children}">
                                <StackPanel Margin="0,5,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="11"
                                            Height="11"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{Binding Icon}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{Binding Count}" />
                                    </Grid>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Resources>
                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                        </TreeView.Resources>
                    </TreeView>
                </GroupBox>
            </Grid>
            <!--  信息  -->
            <Grid Grid.Column="1">
                <GroupBox
                    Grid.Row="0"
                    Margin="0,10,10,10"
                    Padding="0"
                    ui:ElevationAssist.Elevation="Dp2"
                    ui:GroupBoxAssist.HeaderPadding="7"
                    Header="{Binding}"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ui:PackIcon Grid.Column="0" Kind="Details" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 详情}"
                                    TextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <DataGrid
                        Margin="5"
                        snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                        snet:ResxLocalizationProvider.DefaultDictionary="Language"
                        ui:DataGridAssist.CornerRadius="0"
                        ui:DataGridAssist.SelectedCellBorderBrush="Transparent"
                        ui:TextFieldAssist.DecorationVisibility="Collapsed"
                        ui:TextFieldAssist.UnderlineBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        ColumnHeaderHeight="40"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding NodeMessage}"
                        SelectedItem="{Binding NodeMessageSelectedItem}"
                        SelectionMode="Single"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                        <DataGrid.Resources>

                            <!--  滚动条样式  -->
                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />

                            <!--  Header样式  -->
                            <Style
                                x:Key="DataGridColumnHeaderStyle"
                                BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}"
                                TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>

                            <!--  单元格内容居中样式  -->
                            <Style
                                x:Key="DataGridCellStyle"
                                BasedOn="{StaticResource DefaultDataGridCellStyle}"
                                TargetType="{x:Type DataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>

                        </DataGrid.Resources>
                        <!--  双击  -->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedCellsChanged">
                                <snet:EventCommand Command="{Binding DataGrid_SelectedCellsChanged}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                Binding="{Binding Address}"
                                CellStyle="{StaticResource DataGridCellStyle}"
                                HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Address}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 地址}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="150"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                Binding="{Binding Value}"
                                CellStyle="{StaticResource DataGridCellStyle}"
                                HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Value}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 值}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="120"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                Binding="{Binding Type}"
                                CellStyle="{StaticResource DataGridCellStyle}"
                                HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource DataType}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 类型}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="150"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                Binding="{Binding AccessLevel}"
                                CellStyle="{StaticResource DataGridCellStyle}"
                                HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Ver}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 访问级别}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="100"
                                snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
                                snet:ResxLocalizationProvider.DefaultDictionary="Language"
                                Binding="{Binding Description}"
                                CellStyle="{StaticResource DataGridCellStyle}"
                                HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                <DataGridTextColumn.Header>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="13"
                                            Height="13"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{DynamicResource Description}"
                                            Stretch="Fill" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 描述}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
