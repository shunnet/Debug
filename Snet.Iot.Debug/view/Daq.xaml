<UserControl
    x:Class="Snet.Iot.Debug.view.Daq"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Snet.Windows.Controls.handler;assembly=Snet.Windows.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Snet.Iot.Debug.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Snet.Iot.Debug.viewModel"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:uis="http://schemas.lepo.co/wpfui/2022/xaml"
    Padding="30"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Iot.Debug"
    snet:ResxLocalizationProvider.DefaultDictionary="Language">
    <UserControl.DataContext>
        <model:DaqModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <snet:RadioButtonConverter x:Key="RadioButtonConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox
        Grid.Row="0"
        Padding="0"
        ui:ElevationAssist.Elevation="Dp5"
        ui:GroupBoxAssist.HeaderPadding="7"
        Header="{Binding}"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PackIcon Grid.Column="0" Kind="Tools" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding ToolTitle}"
                        TextAlignment="Center" />
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--  右侧打开关闭  -->
            <StackPanel
                Margin="0,-31,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,0,0,0"
                    Command="{Binding On}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource ConnectBase}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 打开}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <Button
                    Width="80"
                    Height="30"
                    Padding="0"
                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                    Command="{Binding Off}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource OffConnect}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 关闭}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
            </StackPanel>

            <!--  数据类型  -->
            <GroupBox
                Margin="10,10,10,0"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="CallMerge" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 数据类型}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <WrapPanel Margin="10">
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Byte"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=1}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="String"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=21}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Double"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=3}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Float"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=4}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Bool"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=2}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Int"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=10}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="UInt"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=12}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Long"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=14}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="ULong"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=16}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Short"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=6}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="UShort"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=8}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />

                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Byte[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=23}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Double[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=25}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Float[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=26}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Bool[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=24}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Int[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=32}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="UInt[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=34}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Long[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=36}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="ULong[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=38}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Short[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=28}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                    <RadioButton
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="UShort[]"
                        IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=30}"
                        Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                </WrapPanel>
            </GroupBox>

            <!--  功能  -->
            <GroupBox
                Grid.Row="1"
                Margin="10,10,10,10"
                Padding="0"
                ui:ElevationAssist.Elevation="Dp2"
                ui:GroupBoxAssist.HeaderPadding="7"
                Header="{Binding}"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PackIcon Grid.Column="0" Kind="Function" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 功能}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid Grid.Row="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Height="40" />
                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Height="40" />

                    <!--  节点地址  -->
                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5,0,0,0"
                        Hint="{snet:Loc 地址}"
                        Icon="{DynamicResource Address}"
                        Text="{Binding Address}" />

                    <!--  长度  -->
                    <snet:TextBoxControl
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Hint="{snet:Loc 长度}"
                        Icon="{DynamicResource Length}"
                        Text="{Binding Length}" />



                    <!--  读取  -->
                    <snet:ButtonControl
                        Grid.Row="0"
                        Grid.Column="2"
                        Width="80"
                        Margin="10,0,10,0"
                        Command="{Binding Read}"
                        Content="{snet:Loc 读取}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Read}" />
                    <!--  读取  -->
                    <snet:ButtonControl
                        Grid.Row="0"
                        Grid.Column="3"
                        Width="110"
                        Margin="0,0,5,0"
                        Command="{Binding Subscribe}"
                        Content="{snet:Loc 订阅}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Subscribe}" />



                    <!--  数据  -->
                    <snet:TextBoxControl
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5,0,0,0"
                        Hint="{snet:Loc 数据}"
                        Icon="{DynamicResource Data}"
                        Text="{Binding Data}" />

                    <!--  编码格式  -->
                    <snet:ComboBoxControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        DisplayMemberPath="Key"
                        Hint="{snet:Loc 编码类型}"
                        Icon="{DynamicResource 编码类型}"
                        ItemsSource="{Binding ComboBoxItemsSource}"
                        SelectedItem="{Binding ComboBoxSelectedItem}" />



                    <!--  写入  -->
                    <snet:ButtonControl
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="80"
                        Margin="10,0,10,0"
                        Command="{Binding Write}"
                        Content="{snet:Loc 写入}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource Write}" />
                    <!--  取消订阅  -->
                    <snet:ButtonControl
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="110"
                        Margin="0,0,5,0"
                        Command="{Binding UnSubscribe}"
                        Content="{snet:Loc 取消订阅}"
                        CornerRadius="{DynamicResource WindowCornerRadius}"
                        Icon="{DynamicResource UnSubscribe}" />
                </Grid>
            </GroupBox>

            <!--  查阅  -->
            <ui:Card Grid.Row="2" Margin="10,0,10,10">
                <TabControl
                    ui:NavigationRailAssist.ShowSelectionBackground="True"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding TabSelectedIndex}"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Left">

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="Tune" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 参数}" />
                            </StackPanel>
                        </TabItem.Header>
                        <snet:PropertyControl
                            Margin="10,0,0,0"
                            BasicsData="{Binding BasicsData}"
                            ExpCommand="{x:Null}"
                            IncCommand="{x:Null}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="MessageAlertOutline" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 信息}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="MessageAlertOutline" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 信息}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <Grid>
                                <!--  清空按钮  -->
                                <Button
                                    Width="80"
                                    Margin="0,-32,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                                    Command="{Binding InfoClear}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource Clear}"
                                                Stretch="Fill" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 清空}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!--  数据框  -->
                                <snet:TextEditorControl
                                    x:Name="edit1"
                                    h:EditBindingHandler.EditText="{Binding InfoEvent}"
                                    IsReadOnly="True"
                                    PreviewKeyDown="TextEditor_PreviewKeyDown"
                                    PreviewTextInput="TextEditor_PreviewTextInput"
                                    TextChanged="TextEditor_TextChanged">
                                    <snet:TextEditorControl.Resources>
                                        <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                        <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                    </snet:TextEditorControl.Resources>
                                </snet:TextEditorControl>

                            </Grid>
                        </GroupBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="Database" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 数据}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="Database" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 数据}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <Grid>
                                <!--  清空按钮  -->
                                <Button
                                    Width="80"
                                    Margin="0,-32,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                                    Command="{Binding DataClear}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource Clear}"
                                                Stretch="Fill" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 清空}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!--  数据框  -->
                                <snet:TextEditorControl
                                    x:Name="edit2"
                                    h:EditBindingHandler.EditText="{Binding DataEvent}"
                                    IsReadOnly="True"
                                    PreviewKeyDown="TextEditor_PreviewKeyDown"
                                    PreviewTextInput="TextEditor_PreviewTextInput"
                                    TextChanged="TextEditor_TextChanged">
                                    <snet:TextEditorControl.Resources>
                                        <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                        <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                    </snet:TextEditorControl.Resources>
                                </snet:TextEditorControl>

                            </Grid>
                        </GroupBox>
                    </TabItem>

                    <TabItem Visibility="{Binding InteractionVisibility}">
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="CursorDefaultClick" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 交互}" />
                            </StackPanel>
                        </TabItem.Header>
                        <GroupBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="0"
                            ui:ElevationAssist.Elevation="Dp4"
                            ui:GroupBoxAssist.HeaderPadding="7"
                            Header="{Binding}"
                            Style="{StaticResource MaterialDesignCardGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:PackIcon
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="CursorDefaultClick" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{snet:Loc 交互}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <Grid>
                                <!--  清空按钮  -->
                                <Button
                                    Width="80"
                                    Margin="0,-32,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                                    Command="{Binding InteractionClear}"
                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource Clear}"
                                                Stretch="Fill" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 清空}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!--  数据框  -->
                                <snet:TextEditorControl
                                    x:Name="edit3"
                                    h:EditBindingHandler.EditText="{Binding InteractionEvent}"
                                    IsReadOnly="True"
                                    PreviewKeyDown="TextEditor_PreviewKeyDown"
                                    PreviewTextInput="TextEditor_PreviewTextInput"
                                    TextChanged="TextEditor_TextChanged">
                                    <snet:TextEditorControl.Resources>
                                        <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                        <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                    </snet:TextEditorControl.Resources>
                                </snet:TextEditorControl>

                            </Grid>
                        </GroupBox>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Width="auto" Height="auto">
                                <ui:PackIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Kind="ChartLine" />
                                <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 图表}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ContentControl Grid.Row="1" Content="{Binding ChartControl}">
                            <ContentControl.Resources>
                                <!--  滚动条样式  -->
                                <Style BasedOn="{StaticResource UiContextMenu}" TargetType="ContextMenu" />
                                <Style BasedOn="{StaticResource UiMenuItem}" TargetType="MenuItem" />
                            </ContentControl.Resources>
                        </ContentControl>
                    </TabItem>

                </TabControl>
            </ui:Card>

            <!--  状态  -->
            <Border
                Grid.Row="3"
                Padding="5"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="0,1,0,0">
                <Grid VerticalAlignment="Bottom">
                    <snet:LedGaugeControl
                        Width="25"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        IsFlashing="{Binding DeviceStatusFlashing}"
                        IsOn="{Binding DeviceStatusChangLiang}"
                        OffLightness="0.1"
                        Color="{Binding LedColor}" />

                </Grid>
            </Border>

        </Grid>
    </GroupBox>
</UserControl>
