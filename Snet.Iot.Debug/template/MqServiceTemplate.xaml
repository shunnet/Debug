<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:h="clr-namespace:Snet.Windows.Controls.handler;assembly=Snet.Windows.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Snet.Iot.Debug.view"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Snet.Iot.Debug.viewModel"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:uis="http://schemas.lepo.co/wpfui/2022/xaml">
    <DataTemplate x:Key="MQSERVICE">
        <GroupBox
            Grid.Row="0"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp5"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="Tools" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding ToolTitle}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!--  右侧打开关闭  -->
                <StackPanel
                    Margin="0,-31,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Height="30"
                        Padding="0"
                        ui:ButtonAssist.CornerRadius="0,0,0,0"
                        Command="{Binding On}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource ConnectBase}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 打开}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        Width="80"
                        Height="30"
                        Padding="0"
                        ui:ButtonAssist.CornerRadius="0,5,0,0"
                        Command="{Binding Off}"
                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Image
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource OffConnect}"
                                    Stretch="Fill" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{snet:Loc 关闭}"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <!--  查阅  -->
                <ui:Card Grid.Row="0" Margin="10,10,10,10">
                    <TabControl
                        ui:NavigationRailAssist.ShowSelectionBackground="True"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        SelectedIndex="{Binding TabSelectedIndex}"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        TabStripPlacement="Left"
                        VirtualizingPanel.IsVirtualizing="False">

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="Tune" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 参数}" />
                                </StackPanel>
                            </TabItem.Header>
                            <snet:PropertyControl
                                Margin="10,0,0,0"
                                BasicsData="{Binding BasicsData}"
                                ExpCommand="{x:Null}"
                                IncCommand="{x:Null}" />
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="MessageAlertOutline" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 信息}" />
                                </StackPanel>
                            </TabItem.Header>
                            <GroupBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                ui:ElevationAssist.Elevation="Dp4"
                                ui:GroupBoxAssist.HeaderPadding="7"
                                Header="{Binding}"
                                Style="{StaticResource MaterialDesignCardGroupBox}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:PackIcon
                                                Grid.Column="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="MessageAlertOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 信息}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <Grid>
                                    <!--  清空按钮  -->
                                    <Button
                                        Width="80"
                                        Margin="0,-32,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        ui:ButtonAssist.CornerRadius="0,5,0,0"
                                        Command="{Binding InfoClear}"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Clear}"
                                                    Stretch="Fill" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 清空}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!--  数据框  -->
                                    <edit:TextEditor
                                        x:Name="edit1"
                                        h:EditBindingHandler.EditText="{Binding InfoEvent}"
                                        IsReadOnly="True">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewKeyDown">
                                                <snet:EventCommand Command="{Binding TextEditor_PreviewKeyDown}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewTextInput">
                                                <snet:EventCommand Command="{Binding TextEditor_PreviewTextInput}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="TextChanged">
                                                <snet:EventCommand Command="{Binding TextEditor_TextChanged}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <edit:TextEditor.Resources>
                                            <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                        </edit:TextEditor.Resources>
                                    </edit:TextEditor>

                                </Grid>
                            </GroupBox>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto" Height="auto">
                                    <ui:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Kind="Database" />
                                    <TextBlock HorizontalAlignment="Center" Text="{snet:Loc 数据}" />
                                </StackPanel>
                            </TabItem.Header>
                            <GroupBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                ui:ElevationAssist.Elevation="Dp4"
                                ui:GroupBoxAssist.HeaderPadding="7"
                                Header="{Binding}"
                                Style="{StaticResource MaterialDesignCardGroupBox}">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:PackIcon
                                                Grid.Column="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="Database" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{snet:Loc 数据}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>
                                <Grid>
                                    <!--  清空按钮  -->
                                    <Button
                                        Width="80"
                                        Margin="0,-32,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        ui:ButtonAssist.CornerRadius="0,5,0,0"
                                        Command="{Binding DataClear}"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Image
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource Clear}"
                                                    Stretch="Fill" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{snet:Loc 清空}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!--  数据框  -->
                                    <edit:TextEditor
                                        x:Name="edit2"
                                        h:EditBindingHandler.EditText="{Binding DataEvent}"
                                        IsReadOnly="True">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewKeyDown">
                                                <snet:EventCommand Command="{Binding TextEditor_PreviewKeyDown}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewTextInput">
                                                <snet:EventCommand Command="{Binding TextEditor_PreviewTextInput}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="TextChanged">
                                                <snet:EventCommand Command="{Binding TextEditor_TextChanged}" UseEventCommandArgs="True" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <edit:TextEditor.Resources>
                                            <Style BasedOn="{StaticResource UiScrollViewer}" TargetType="ScrollViewer" />
                                            <Style BasedOn="{StaticResource UiScrollBar}" TargetType="ScrollBar" />
                                        </edit:TextEditor.Resources>
                                    </edit:TextEditor>

                                </Grid>
                            </GroupBox>
                        </TabItem>
                    </TabControl>
                </ui:Card>

                <!--  状态  -->
                <Border
                    Grid.Row="1"
                    Padding="5"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                    BorderThickness="0,1,0,0">
                    <Grid VerticalAlignment="Bottom">
                        <snet:LedGaugeControl
                            Width="25"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            IsFlashing="{Binding DeviceStatusFlashing}"
                            IsOn="{Binding DeviceStatusChangLiang}"
                            OffLightness="0.1"
                            Color="{Binding LedColor}" />

                    </Grid>
                </Border>



            </Grid>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>